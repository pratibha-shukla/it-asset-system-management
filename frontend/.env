# Left unset on purpose — axiosInstance.js and useServerEvents.js default to a
# RELATIVE API path when this is empty, so requests go through Vite's dev-server
# proxy (see vite.config.js) and stay same-origin with the frontend. This is
# required for the httpOnly auth cookies (SameSite=Lax) to be sent/received
# without cross-site restrictions. Only set this to an absolute URL if the
# frontend and API are intentionally served from different origins (that setup
# additionally needs SameSite=None + HTTPS on the backend).
# VITE_API_BASE_URL=http://localhost:8080
